---
import { links } from '../config';
---

<section id="aboutUs" class="about-us">
  <div class="container">
    <p>
      After almost 6 years of amazing in-person and virtual events iOSDevHappyHour is taking a break. We'd like to thank everyone who's been along for the ride, and...
    </p>
  </div>
</section>

<style>
  .about-us {
    position: relative;
    z-index: 1;
    padding: 80px 20px 20px;
    background: var(--white);
    color: var(--navy);
    text-align: center;
  }

  .section-header {
    margin: 0 0 0.5rem;
    font-size: 2.5rem;
    font-weight: 500;
    line-height: 1.2;
  }

  hr {
    margin: 1rem 0;
    border: 0;
    border-top: 2px solid var(--orange);
    border-radius: 1px;
  }

  p {
    margin: 0 0 1rem;
    padding: 0 0 25px;
    font-size: 1.375rem;
    line-height: 1.6;
  }

  .link {
    color: var(--orange);
    text-decoration: underline;
  }

  .link:hover {
    color: var(--orange-dark);
  }
</style>
